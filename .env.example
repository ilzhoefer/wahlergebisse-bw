# Local dev Postgres, started via docker-compose.yaml (local dev/test only)
DATABASE_URL="postgres://election:election@localhost:5432/election"

# Admin page password (Phase 3)
ADMIN_PASSWORD="changeme"

# Signs the admin session cookie — generate a real random secret in production, e.g. `openssl rand -hex 32`.
SESSION_SECRET="changeme"

# Site operator, shown in the Impressum and Datenschutzerklärung (address: comma-separated lines).
OPERATOR_NAME="Max Mustermann"
OPERATOR_ADDRESS="Musterstraße 1, 12345 Musterstadt"
OPERATOR_EMAIL="kontakt@example.org"
