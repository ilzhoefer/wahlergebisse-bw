# Local dev Postgres, started via docker-compose.yaml (local dev/test only)
DATABASE_URL="postgres://election:election@localhost:5432/election"

# Admin page password. Production refuses to start with "changeme" or fewer than 12 characters.
ADMIN_PASSWORD="changeme"

# Signs the admin session cookie. Production needs at least 32 characters: `openssl rand -hex 32`.
SESSION_SECRET="changeme"

# Production only: the public URL. adapter-node then ignores the request's Host header for url.origin
# (sitemap.xml links, CSRF check). Behind a proxy also set ADDRESS_HEADER (e.g. X-Forwarded-For) so
# the login rate limit sees real client IPs.
# ORIGIN="https://wahlen.example.org"

# Site operator, shown in the Impressum and Datenschutzerklärung (address: comma-separated lines).
OPERATOR_NAME="Max Mustermann"
OPERATOR_ADDRESS="Musterstraße 1, 12345 Musterstadt"
OPERATOR_EMAIL="kontakt@example.org"
